TRACEQA_DATABASE_URL=postgresql+psycopg://traceqa:traceqa@localhost:5432/traceqa
TRACEQA_DB_ECHO=false
TRACEQA_TEST_LOGS_DIRECTORY=C:\TraceQA\test-logs
